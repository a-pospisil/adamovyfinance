# Kontaktní formulář (/api/kontakt) – bez e-mailu i CRM formulář odkazuje na WhatsApp / telefon / e-mail.
RESEND_API_KEY=
LEAD_TO_EMAIL=adam.pospisil@egfin.cz
LEAD_FROM_EMAIL=Web adamovyfinance.cz <web@adamovyfinance.cz>

# Raynet CRM – z poptávky vznikne lead (předmět = jméno a příjmení) a telefonát
# na nejbližší volnou pracovní hodinu. Bez těchto hodnot se CRM přeskočí.
# API klíč: Raynet → Nastavení aplikace → Pro vývojáře → API klíče.
RAYNET_API_KEY=
RAYNET_USERNAME=adam.pospisil@egfin.cz
RAYNET_INSTANCE_NAME=evergreen
# ID uživatele, který lead i telefonát vlastní (2 = Adam Pospíšil)
RAYNET_OWNER_ID=2
# Číselníky instance: kategorie leadu 194 = „Adam Pospíšil“ (tipař), zdroj kontaktu 79 = „web/poptávka“
RAYNET_LEAD_CATEGORY_ID=194
RAYNET_CONTACT_SOURCE_ID=79

# Volitelné – výchozí hodnoty: pracovní dny 9:00–17:00 (poslední slot 16:45), slot 15 minut, aktivita = telefonát
# RAYNET_WORK_HOURS=9-17      # konec je exkluzivní; lze i s minutami, např. 9:00-16:45
# RAYNET_WORK_DAYS=1-5        # 1 = pondělí … 7 = neděle; včetně víkendu = 1-7
# RAYNET_SLOT_MINUTES=15
# RAYNET_ACTIVITY_TYPE=phoneCall   # nebo task
